{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gaia.js.org/spec/v1/feature-collection.schema.json",
  "title": "Gaia Feature Collection",
  "description": "A Gaia Feature Collection, extending GeoJSON FeatureCollection.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://geojson.org/schema/FeatureCollection.json"
    }
  ],
  "properties": {
    "href": {
      "type": "string",
      "format": "uri"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "https://geojson.org/schema/Feature.json"
          }
        ],
        "properties": {
          "href": {
            "type": "string",
            "format": "uri"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": ["href"]
      }
    }
  },
  "required": ["href"]
}
