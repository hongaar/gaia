{
  "name": "gaia",
  "version": "0.0.0",
  "private": true,
  "repository": "github:hongaar/gaia",
  "license": "MIT",
  "author": "Joram van den Boezem <joram@vandenboezem.nl>",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run start:dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:clean": "npm run build:clean --workspaces --if-present",
    "build:watch": "npm run build:watch --workspaces --if-present",
    "doctoc": "doctoc README.md",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "postinstall": "husky install",
    "release": "semantic-release",
    "test": "npm test --workspaces --if-present",
    "todos": "leasot --exit-nicely --reporter markdown --ignore \"**/node_modules\" \"**/*.ts\" > TODO.md",
    "typescript": "npm run build:clean && tsc --build --force",
    "typescript:watch": "tsc --build --watch",
    "start:dev": "npm run typescript:watch"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/git": "10.0.1",
    "doctoc": "2.2.1",
    "husky": "9.1.7",
    "leasot": "14.4.0",
    "lint-staged": "15.5.0",
    "moker": "4.3.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.5.3",
    "@semantic-release/npm": "12.0.1",
    "semantic-release": "24.2.3",
    "typescript": "5.8.2"
  },
  "packageManager": "npm@10.9.8",
  "moker": {
    "plugins": [
      "prettier",
      "doctoc",
      "semantic-release",
      "github-actions",
      "husky",
      "lint-staged",
      "todos",
      "dependabot"
    ],
    "scoped": true
  }
}
